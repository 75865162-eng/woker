/// 税务发票台账（VAT / GST / SALES_TAX）。税率为万分比，税额由服务层按含税/不含税口径换算。
model TaxInvoice {
  id             String         @id @default(cuid())
  organizationId String
  workspaceId    String         @default("default")
  country        String         @default("DE")
  taxType        String         @default("VAT")
  invoiceNo      String
  invoiceDate    DateTime       @db.Date
  counterparty   String         @default("")
  currency       String         @default("EUR")
  taxableAmount  Decimal        @db.Decimal(20, 6)
  taxRateBp      Int
  taxAmount      Decimal        @db.Decimal(20, 6)
  /// INPUT 进项 / OUTPUT 销项
