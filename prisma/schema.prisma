  planLine       FbaLocalPlanLine           @relation(fields: [organizationId, workspaceId, planId, planLineId], references: [organizationId, workspaceId, planId, id], onDelete: Restrict, onUpdate: Restrict, map: "FbaLocalCustomsItem_planline_fkey")

