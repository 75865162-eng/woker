  adOrders Int?
  adSales Float?
  payload Json
  syncedAt DateTime @default(now())
  SellfoxStore SellfoxStore @relation(fields: [storeId], references: [id], onDelete: Restrict)
  @@unique([storeId, reportDate, adType, campaignId, placement], map: "sellfox_ads_placement_daily_identity")
  @@index([organizationId, workspaceId, storeId, reportDate])
  @@index([organizationId, workspaceId, asin, reportDate])
}


// Phase 1 authorizations are the only credential source for opted-in sync scopes.
// Legacy AmazonIntegrationSecret remains read-compatible for scopes not migrated.
model AmazonSpApiAuthorization {
  id                    String @id
  organizationId        String
  workspaceId           String @default("default")
  name                  String
  amazonSellerId        String
  awsRegion             String
  endpoint              String
  credentialsCiphertext String @db.Text
  revision              Int @default(1)
  status                String @default("NOT_CONFIGURED")
  marketplaceParticipations Json @default("[]")
  lastValidatedAt       DateTime?
  identityVerifiedAt    DateTime?
  identityEvidence      String @default("MANUAL_UNVERIFIED")
  authorizedByUserId    String?
  validationAttemptedAt DateTime?
  validationErrorCode   String?
  updatedByUserId        String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  sources               AmazonSyncDataSource[]

  @@unique([organizationId, workspaceId, id], map: "AmazonAuth_scope_id_key")
  @@unique([organizationId, workspaceId, amazonSellerId, awsRegion], map: "AmazonAuth_seller_region_key")
}

model AmazonSyncDataSource {
  id                    String @id
  organizationId        String
  workspaceId           String @default("default")
  authorizationId       String
  authorization         AmazonSpApiAuthorization @relation(fields: [organizationId, workspaceId, authorizationId], references: [organizationId, workspaceId, id], onDelete: Restrict)
  sellerAccountId       String
  seller                SellerAccount @relation(fields: [organizationId, workspaceId, sellerAccountId], references: [organizationId, workspaceId, id], onDelete: Restrict)
  marketplaceId         String
  resource              String
  source                String @default("amazon_sp_api")
  enabled               Boolean @default(true)
  freshnessMinutes      Int
  activeRunId           String?
  publishedRun          AmazonSyncRun? @relation("PublishedHead", fields: [activeRunId, organizationId, workspaceId, id], references: [id, organizationId, workspaceId, sourceId], onDelete: Restrict)
  lastSuccessAt         DateTime?
  rowCount              Int @default(0)
  coverage              Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  salesTrafficRows      AmazonSalesTrafficSnapshot[]
  runs                  AmazonSyncRun[] @relation("SourceTasks")
  targets               AmazonSyncPlanTarget[]

  @@unique([organizationId, workspaceId, id], map: "AmazonSource_scope_id_key")
  @@unique([organizationId, workspaceId, sellerAccountId, marketplaceId, resource], map: "AmazonSource_store_site_domain_key")
  revision Int @default(1)

}

model AmazonSyncPlanTarget {
  organizationId String
  workspaceId    String
  scheduleId     String
  sourceId       String
  schedule       AmazonSyncSchedule @relation(fields: [organizationId, workspaceId, scheduleId], references: [organizationId, workspaceId, id], onDelete: Cascade)
  source         AmazonSyncDataSource @relation(fields: [organizationId, workspaceId, sourceId], references: [organizationId, workspaceId, id], onDelete: Restrict)

  @@id([scheduleId, sourceId])
}

model AmazonSyncTaskLog {
  id              String @id
  organizationId  String
  workspaceId     String
  taskId          String
  task            AmazonSyncRun @relation(fields: [organizationId, workspaceId, taskId], references: [organizationId, workspaceId, id], onDelete: Cascade)
  attempt         Int
  event           String
  stage           String
  page            Int?
  code            String?
  requestId       String?
  statusCode      Int?
  rateLimit       String?
  createdAt       DateTime @default(now())

  @@index([organizationId, workspaceId, taskId, createdAt], map: "AmazonTaskLog_task_time_idx")
}

model AmazonSyncPage {
  organizationId String
  workspaceId    String
  taskId         String
  task           AmazonSyncRun @relation(fields: [organizationId, workspaceId, taskId], references: [organizationId, workspaceId, id], onDelete: Cascade)
  page           Int
  tokenHash      String
  rowCount       Int
  createdAt      DateTime @default(now())

  @@id([taskId, page])
  @@unique([taskId, tokenHash], map: "AmazonSyncPage_token_key")
}

model AmazonSyncApiBudget {
  organizationId String
  workspaceId    String
  authorizationId String
  operation      String
  nextRequestAt  DateTime @default(now())
  observedLimit  Float?
  updatedAt      DateTime @updatedAt

  @@id([organizationId, workspaceId, authorizationId, operation])
}

// Seller/day totals only. ASIN range totals are deliberately not split into daily facts.
model AmazonSalesTrafficSnapshot {
  id String @id
  organizationId String
  workspaceId String
  sourceId String
  source AmazonSyncDataSource @relation(fields: [organizationId, workspaceId, sourceId], references: [organizationId, workspaceId, id], onDelete: Restrict, map: "AmazonSalesTraffic_source_fkey")
  syncRunId String
  task AmazonSyncRun @relation(fields: [syncRunId, organizationId, workspaceId, sourceId], references: [id, organizationId, workspaceId, sourceId], onDelete: Restrict, map: "AmazonSalesTraffic_task_fkey")
  sellerAccountId String
  marketplaceId String
  businessDate String @db.VarChar(10)
  reportId String
  documentId String
  metrics Json
  quality String
  capturedAt DateTime

  @@unique([organizationId, workspaceId, syncRunId, businessDate], map: "AmazonSalesTraffic_run_date_key")
  @@index([organizationId, workspaceId, sourceId, businessDate], map: "AmazonSalesTraffic_scope_date_idx")
}

model AmazonDataExport {
  id String @id
  organizationId String
  workspaceId String
  requestedByUserId String
  idempotencyKey String
  query Json
  cutoff DateTime
  status String @default("QUEUED")
  fileId String?
  file FileObject? @relation(fields: [fileId], references: [id], onDelete: Restrict, map: "AmazonDataExport_file_fkey")
  workspace WorkspaceScope @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Restrict, map: "AmazonDataExport_workspace_fkey")
  actor OrganizationMember @relation(fields: [organizationId, requestedByUserId], references: [organizationId, userId], onDelete: Restrict, map: "AmazonDataExport_actor_fkey")
  rowCount Int @default(0)
  error String?
  createdAt DateTime @default(now())
  finishedAt DateTime?
  leaseExpiresAt DateTime?
  fence Int @default(0)
  @@unique([organizationId, workspaceId, requestedByUserId, idempotencyKey], map: "AmazonDataExport_idempotency_key")
  @@index([status, createdAt])
}

// Scope authorization complements existing RBAC; no implicit grants for ordinary members.
model AmazonDataAccessGrant {
  id String @id
  organizationId String
  workspaceId String
  userId String
  sellerAccountId String
  enabled Boolean @default(true)
  marketplaceIds String[] @default([])
  actions String[] @default(["view", "sync", "export", "edit"])
  mcpEnabled Boolean @default(false)
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  member OrganizationMember @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Restrict)
  workspace WorkspaceScope @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Restrict)
  seller SellerAccount @relation(fields: [organizationId, workspaceId, sellerAccountId], references: [organizationId, workspaceId, id], onDelete: Restrict)
  @@unique([organizationId, workspaceId, userId, sellerAccountId], map: "AmazonAccess_member_seller_key")
  @@index([organizationId, workspaceId, userId, enabled], map: "AmazonAccess_lookup_idx")
}

model AmazonRoleDataAccessGrant {
  id String @id
  organizationId String
  workspaceId String
  roleId String
  sellerAccountId String
  marketplaceIds String[] @default([])
  actions String[] @default([])
  mcpEnabled Boolean @default(false)
  enabled Boolean @default(true)
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([organizationId, workspaceId, roleId, sellerAccountId], map: "AmazonRoleGrant_scope_subject_seller_key")
  @@index([organizationId, workspaceId, roleId, enabled], map: "AmazonRoleGrant_scope_subject_enabled_idx")
}

model AmazonMcpCredential {
  id String @id
  organizationId String
  workspaceId String
  userId String
  name String
  tokenHash String @unique
  tokenPrefix String
  tools String[]
  scopes Json
  status String @default("ACTIVE")
  revision Int @default(1)
  expiresAt DateTime
  createdByUserId String
  rotatedFromId String?
  lastUsedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([organizationId, workspaceId, userId, status])
}

model AmazonOAuthAttempt {
  id String @id
  organizationId String
  workspaceId String
  userId String
  stateHash String @unique
  region String
  redirectUri String
  status String @default("PENDING")
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AmazonSellerIdentity {
  id String @id
  organizationId String
  workspaceId String
  sellerAccountId String
  amazonSellerId String
  marketplaceId String
  region String
  authorizationId String
  verifiedAt DateTime
  @@unique([organizationId, workspaceId, sellerAccountId, marketplaceId], map: "AmazonIdentity_scope_seller_site_key")
  @@unique([organizationId, workspaceId, amazonSellerId, marketplaceId, region], map: "AmazonIdentity_scope_amazon_site_region_key")
}
