  createdBy             String
  revision              Int            @default(1)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  organization          Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace             WorkspaceScope @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, workspaceId, id])
  @@unique([organizationId, workspaceId, marketplace, asin], map: "CompetitorOfferWatch_asin_key")
  @@index([organizationId, workspaceId, buyBoxStatus, lastSeenAt])
}

/// 调价队列：由观察 + 规则算出建议价，人工采纳后才视为生效，绝不自动改线上价。
model RepricingQueueItem {
  id             String         @id @default(cuid())
  organizationId String
  workspaceId    String         @default("default")
  marketplace    String         @default("US")
  asin           String
  sellerSku      String         @default("")
  ruleId         String         @default("")
  currentPrice   Decimal        @db.Decimal(20, 6)
  suggestedPrice Decimal        @db.Decimal(20, 6)
