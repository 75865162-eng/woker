// AP/AR evidence is derived from posted vouchers; registration does not post again.
model FinanceOpenItem {
  id                  String              @id
  organizationId      String
  workspaceId         String
  bookId              String
  voucherId           String
  subjectId           String
  counterparty        String
  kind                String
  currency            String
  amount              Decimal             @db.Decimal(30, 6)
  dueDate             DateTime            @db.Date
  evidence            String
  status              String              @default("OPEN")
  revision            Int                 @default(1)
  createdBy           String
  createdAt           DateTime            @default(now()) @db.Timestamptz(3)
  book                FinanceBook         @relation(fields: [organizationId, workspaceId, bookId], references: [organizationId, workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  voucher             FinanceVoucher      @relation(fields: [organizationId, workspaceId, bookId, voucherId], references: [organizationId, workspaceId, bookId, id], onDelete: Restrict, onUpdate: Restrict)
  subject             FinanceSubject      @relation(fields: [organizationId, workspaceId, bookId, subjectId], references: [organizationId, workspaceId, bookId, id], onDelete: Restrict, onUpdate: Restrict)
  documentSettlements FinanceSettlement[] @relation("SettlementDocument")
