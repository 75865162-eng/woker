  sellerSku       String
  asin            String         @default("")
  targetQty       Int
  targetRevenue   Decimal        @db.Decimal(20, 6)
  unitCost        Decimal        @default(0) @db.Decimal(20, 6)
  historyDailyAvg Decimal        @default(0) @db.Decimal(20, 6)
  forecastQty     Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  plan            SalesPlan      @relation(fields: [organizationId, workspaceId, planId], references: [organizationId, workspaceId, id], onDelete: Cascade)

  @@unique([organizationId, workspaceId, id])
  @@unique([organizationId, workspaceId, planId, sellerSku])
  @@index([organizationId, workspaceId, planId])
}

/// 请款单：采购付款申请，独立于付款记录，审批通过后才允许登记付款。
