  workspace      WorkspaceScope @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, workspaceId, id])
  @@unique([organizationId, workspaceId, country, invoiceNo], map: "TaxInvoice_no_key")
  @@index([organizationId, workspaceId, filingPeriod, direction])
}

/// 申报期：按国家 + 税种 + 期间归集，金额由发票台账汇总，不接受手工改写。
model TaxFilingPeriod {
  id             String         @id @default(cuid())
