/// 滞销判定快照：只读库存、库龄与销量后固化结论，避免报表随数据漂移。
model UnsalableAssessment {
  id              String         @id
  organizationId  String
  workspaceId     String         @default("default")
  warehouseId     String
  asOfDate        DateTime       @db.Date
  policyReference String
  slowDays        Int
  minSalesQty     Int
  records         Json
  recordCount     Int
  sourceHash      String
  status          String         @default("CAPTURED")
  createdBy       String
  createdAt       DateTime       @default(now())
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace       WorkspaceScope @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, workspaceId, id])
  @@unique([organizationId, workspaceId, warehouseId, asOfDate], map: "UnsalableAssessment_day_key")
  @@index([organizationId, workspaceId, asOfDate])
}

// ─────────────────────────────────────────────────────────────────────────────
// 功能补全：wimoor 有、woker 缺的 8 个业务域
// 统一口径：scope（organizationId + workspaceId）+ revision 乐观锁 + createdBy 审计。
// 跨表引用除主子表外一律存 ID 文本，避免在迁移期引入多余外键阻塞线上写入。
// ─────────────────────────────────────────────────────────────────────────────

/// 计算器中心：FBA 费用测算与利润测算方案。inputs/result 为快照，改口径不影响历史方案。
model CalcScheme {
  id             String         @id @default(cuid())
  organizationId String
  workspaceId    String         @default("default")
  name           String
  /// FBA_FEE 费用测算 / PROFIT 利润测算
  kind           String         @default("PROFIT")
  marketplace    String         @default("US")
  currency       String         @default("CNY")
  inputs         Json
  result         Json
  notes          String         @default("")
  createdBy      String
  revision       Int            @default(1)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace      WorkspaceScope @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, workspaceId, id])
  @@unique([organizationId, workspaceId, name])
  @@index([organizationId, workspaceId, kind, createdAt])
}

/// 评论与差评跟踪。externalId 为平台侧唯一标识，手工录入留空。
model ReviewRecord {
  id             String         @id @default(cuid())
  organizationId String
  workspaceId    String         @default("default")
  marketplace    String         @default("US")
  asin           String         @default("")
  sellerSku      String         @default("")
  rating         Int
  /// POSITIVE / NEUTRAL / NEGATIVE
  sentiment      String         @default("NEUTRAL")
  title          String         @default("")
  content        String         @default("")
  reviewer       String         @default("")
  reviewedAt     DateTime       @db.Date
  /// MANUAL / SPAPI_REPORT / IMPORT
  source         String         @default("MANUAL")
  externalId     String?
  /// NEW / REPLIED / IGNORED
  status         String         @default("NEW")
  replyText      String         @default("")
  repliedAt      DateTime?
  createdBy      String
  revision       Int            @default(1)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace      WorkspaceScope @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, workspaceId, id])
  @@unique([organizationId, workspaceId, externalId], map: "ReviewRecord_external_key")
  @@index([organizationId, workspaceId, sentiment, reviewedAt])
  @@index([organizationId, workspaceId, asin, reviewedAt])
}

/// 店铺绩效快照。比率统一万分比（120 = 1.20%），阈值判定在服务层做，不改写平台原值。
model StorePerformanceSnapshot {
  id                     String         @id @default(cuid())
  organizationId         String
  workspaceId            String         @default("default")
  marketplace            String         @default("US")
  periodStart            DateTime       @db.Date
  periodEnd              DateTime       @db.Date
  totalOrders            Int            @default(0)
  orderDefectRateBp      Int            @default(0)
  lateShipmentRateBp     Int            @default(0)
  cancellationRateBp     Int            @default(0)
  validTrackingRateBp    Int            @default(0)
  negativeFeedbackRateBp Int            @default(0)
  policyReference        String         @default("")
  /// CAPTURED 已固化 / SUPERSEDED 被新快照替代
  status                 String         @default("CAPTURED")
  createdBy              String
  createdAt              DateTime       @default(now())
  organization           Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace              WorkspaceScope @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, workspaceId, id])
  @@unique([organizationId, workspaceId, marketplace, periodStart], map: "StorePerformanceSnapshot_period_key")
  @@index([organizationId, workspaceId, periodStart])
}

/// 调价规则：地板价/天花板价/步长/最低毛利，逐个字段上限由业务校验兜底。
model RepricingRule {
  id             String         @id @default(cuid())
  organizationId String
  workspaceId    String         @default("default")
  name           String
  marketplace    String         @default("US")
  /// MATCH_LOWEST / BEAT_LOWEST / HOLD
  strategy       String         @default("MATCH_LOWEST")
  floorPrice     Decimal        @db.Decimal(20, 6)
  ceilingPrice   Decimal        @db.Decimal(20, 6)
  stepAmount     Decimal        @default(0) @db.Decimal(20, 6)
  minMarginBp    Int            @default(0)
  enabled        Boolean        @default(true)
  notes          String         @default("")
  createdBy      String
  revision       Int            @default(1)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace      WorkspaceScope @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, workspaceId, id])
  @@unique([organizationId, workspaceId, name])
  @@index([organizationId, workspaceId, enabled, marketplace])
}

/// 跟卖与购物车监控快照。同一 ASIN 同站点只保留一条最新观察。
model CompetitorOfferWatch {
  id                    String         @id @default(cuid())
  organizationId        String
  workspaceId           String         @default("default")
  marketplace           String         @default("US")
  asin                  String
  sellerSku             String         @default("")
  myPrice               Decimal        @db.Decimal(20, 6)
  buyBoxPrice           Decimal        @default(0) @db.Decimal(20, 6)
  lowestCompetitorPrice Decimal        @default(0) @db.Decimal(20, 6)
  competitorCount       Int            @default(0)
  buyBoxOwner           String         @default("")
  /// WINNING / LOSING / UNKNOWN
  buyBoxStatus          String         @default("UNKNOWN")
