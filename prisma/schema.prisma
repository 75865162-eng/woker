  observationId       String
  spApiInboundPlanId  String
  spApiShipmentId     String
  sourceStatus        String?
  warehouseId         String?
  capturedAt          DateTime
  sourceFacts         Json
  mappingEvidence     String
  idempotencyKey      String
  requestHash         String
  createdBy           String
  createdAt           DateTime                     @default(now())
  plan                FbaLocalPlan                 @relation(fields: [organizationId, workspaceId, planId], references: [organizationId, workspaceId, id], onDelete: Restrict, onUpdate: Restrict, map: "FbaLocalShipment_plan_fkey")
  sourceRun           AmazonSyncRun                @relation(fields: [sourceRunId, organizationId, workspaceId, sourceId], references: [id, organizationId, workspaceId, sourceId], onDelete: Restrict, onUpdate: Restrict, map: "FbaLocalShipment_run_fkey")
