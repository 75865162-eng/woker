  period         String
  taxableAmount  Decimal        @default(0) @db.Decimal(20, 6)
  taxAmount      Decimal        @default(0) @db.Decimal(20, 6)
  /// OPEN / FILED
  status         String         @default("OPEN")
  filedAt        DateTime?
  reference      String         @default("")
  createdBy      String
  revision       Int            @default(1)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace      WorkspaceScope @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, workspaceId, id])
  @@unique([organizationId, workspaceId, country, taxType, period], map: "TaxFilingPeriod_key")
  @@index([organizationId, workspaceId, status, period])
}

/// 多渠道店铺档案：Amazon 之外的自营渠道（eBay / Walmart / Temu / TikTok / Shopify）。
model MultiChannelAccount {
  id             String         @id @default(cuid())
