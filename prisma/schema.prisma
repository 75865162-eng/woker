// t_erp_outwh_form: local outbound demand, separate from per-balance reservations.
enum WmsOutboundStatus {
  DRAFT
  RELEASED
  COMPLETED
  CANCELLED
}

model WmsOutbound {
  id              String            @id
  organizationId  String
  workspaceId     String
  warehouseId     String
  number          String
  customer        String?
  deliveryAddress String?
  carrier         String?
  trackingNumber  String?
  remark          String?
  status          WmsOutboundStatus @default(DRAFT)
  createdBy       String
  revision        Int               @default(1)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  warehouse       WmsWarehouse      @relation(fields: [organizationId, workspaceId, warehouseId], references: [organizationId, workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  creator         User              @relation("WmsOutboundCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lines           WmsOutboundLine[]

  @@unique([organizationId, workspaceId, id])
  @@unique([organizationId, workspaceId, warehouseId, id], map: "WmsOutbound_scope_warehouse_key")
  @@unique([organizationId, workspaceId, number])
  @@index([organizationId, workspaceId, warehouseId, status, createdAt, id], map: "WmsOutbound_work_idx")
}

// t_erp_outwh_form_entry: product demand; batch/location allocation belongs to reservations.
model WmsOutboundLine {
  consumables     WmsOutboundConsumable[]
  id              String                  @id
  organizationId  String
  workspaceId     String
  warehouseId     String
  outboundId      String
  productRecordId String
  requestedQty    Int
  revision        Int                     @default(1)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  outbound        WmsOutbound             @relation(fields: [organizationId, workspaceId, warehouseId, outboundId], references: [organizationId, workspaceId, warehouseId, id], onDelete: Restrict, onUpdate: Restrict)
  product         ProductRecord           @relation(fields: [organizationId, workspaceId, productRecordId], references: [organizationId, workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  reservations    WmsReservation[]

  @@unique([organizationId, workspaceId, id])
  @@unique([organizationId, workspaceId, warehouseId, id], map: "WmsOutboundLine_scope_warehouse_key")
  @@unique([organizationId, workspaceId, outboundId, productRecordId], map: "WmsOutboundLine_scope_product_key")
  @@index([organizationId, workspaceId, productRecordId, createdAt, id], map: "WmsOutboundLine_product_idx")
}

// Local declaration evidence; reviewed is a local review, not customs acceptance.
model FbaLocalCustomsDeclaration {
  templateExports    FbaCustomsExport[]
  id                 String                   @id
  organizationId     String
  workspaceId        String
  planId             String
  shipmentId         String
  number             String
  destinationCountry String
  currency           String
  exporter           String
  importer           String
  templateReference  String
  evidence           String
  idempotencyKey     String
  requestHash        String
  createdBy          String
  reviewedBy         String?
  reviewedAt         DateTime?
  status             String                   @default("DRAFT")
  createdAt          DateTime                 @default(now())
  plan               FbaLocalPlan             @relation(fields: [organizationId, workspaceId, planId], references: [organizationId, workspaceId, id], onDelete: Restrict, onUpdate: Restrict, map: "FbaLocalCustomsDeclaration_plan_fkey")
  shipment           FbaLocalShipment         @relation(fields: [organizationId, workspaceId, planId, shipmentId], references: [organizationId, workspaceId, planId, id], onDelete: Restrict, onUpdate: Restrict, map: "FbaLocalCustomsDeclaration_shipment_fkey")
  items              FbaLocalCustomsItem[]
  events             FbaLocalClearanceEvent[]

  @@unique([organizationId, workspaceId, planId, id], map: "FbaLocalCustomsDeclaration_scope_plan_id_key")
  @@unique([organizationId, workspaceId, planId, number], map: "FbaLocalCustomsDeclaration_number_key")
  @@unique([organizationId, workspaceId, planId, idempotencyKey], map: "FbaLocalCustomsDeclaration_request_key")
  @@unique([organizationId, workspaceId, id], map: "FbaLocalCustomsDeclaration_identity_key")
}

