generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                             String                          @id @default(cuid())
  name                           String
  slug                           String                          @unique
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
  auditLogs                      AuditLog[]
  dataChangeVersions             DataChangeVersion[]
  externalIntegrationSettings    ExternalIntegrationSetting[]
  members                        OrganizationMember[]
  notifications                  UserNotification[]
  marketplaces                   Marketplace[]
  productMeetingNotes            ProductMeetingNote[]
  productListCacheRecords        ProductListCacheRecord[]
  rosterRoles                    OrganizationRosterRole[]
  wecomNotificationSettings      WeComNotificationSetting[]
  productListSummaryRecords      ProductListSummaryRecord[]
  rolePermissions                OrganizationRolePermission?
  teamRoster                     TeamRosterMember[]
  workerHeartbeats               WorkerHeartbeat[]
  pointsPolicy                   PointsPolicy?
  pointsAccounts                 PointsAccount[]
  pointsGrants                   PointsGrant[]
  pointsLedgers                  PointsLedger[]
  pointsPeriods                  PointsPeriod[]
  pointsRequests                 PointsRequest[]
  pointsPriceRules               PointsPriceRule[]
  pointsOverrides                PointsMemberOverride[]
  pointsAllocations              PointsAllocation[]
  workspaceScopes                WorkspaceScope[]
  imageUpscaleJobs               ImageUpscaleJob[]
  productAttachmentBindings      ProductAttachmentBinding[]
  productOutboxEvents            ProductOutboxEvent[]
  productSummaryRecords          ProductSummaryRecord[]
  productTextRecords             ProductTextRecord[]
  productProjectionStates        ProductProjectionState[]
  productProjectionFailures      ProductProjectionFailure[]
  sellerAccounts                 SellerAccount[]
  suppliers                      Supplier[]
  purchaseOrders                 PurchaseOrder[]
  purchasePlans                  PurchasePlan[]
  productCatalogEntries          ProductCatalogEntry[]
  productMasters                 ProductMaster[]
  productVariants                ProductVariant[]
  productListings                ProductListing[]
  productSuppliers               ProductSupplier[]
  productCosts                   ProductCost[]
  productMedia                   ProductMedia[]
  amazonDataCenterChangeRequests AmazonDataCenterChangeRequest[]
  financeBooks                   FinanceBook[]
  financeExpenses                FinanceExpense[]
  purchasePlanApprovals          PurchasePlanApproval[]
  purchaseInvoices               PurchaseInvoice[]
  purchaseInvoiceApprovals       PurchaseInvoiceApproval[]
  carriers                       Carrier[]
  thirdPartyWarehouses           ThirdPartyWarehouse[]
  unsalableAssessments           UnsalableAssessment[]
  calcSchemes                    CalcScheme[]
  reviewRecords                  ReviewRecord[]
  storePerformanceSnapshots      StorePerformanceSnapshot[]
  repricingRules                 RepricingRule[]
  competitorOfferWatches         CompetitorOfferWatch[]
  repricingQueueItems            RepricingQueueItem[]
  salesPlans                     SalesPlan[]
  purchasePaymentRequests        PurchasePaymentRequest[]
  purchaseExchangeOrders         PurchaseExchangeOrder[]
  supplierQuotations             SupplierQuotation[]
  taxInvoices                    TaxInvoice[]
  taxFilingPeriods               TaxFilingPeriod[]
  multiChannelAccounts           MultiChannelAccount[]
  multiChannelOrders             MultiChannelOrder[]
  dataDictionaries               DataDictionary[]
  dataDictionaryItems            DataDictionaryItem[]
  customFieldDefinitions         CustomFieldDefinition[]
}

model User {
  adsChangesCreated                       AmazonAdsChangeDraft[]          @relation("AdsChangeCreator")
  adsChangesReviewed                      AmazonAdsChangeDraft[]          @relation("AdsChangeReviewer")
  wmsOutbounds                            WmsOutbound[]                   @relation("WmsOutboundCreator")
  fbaLocalPlans                           FbaLocalPlan[]
  wmsCountedLines                         WmsStocktakeLine[]
  wmsStocktakes                           WmsStocktake[]
  wmsReceipts                             WmsReceipt[]                    @relation("WmsReceiptCreator")
  wmsReservations                         WmsReservation[]                @relation("WmsReservationCreator")
  wmsCommands                             WmsCommand[]
  wmsMovements                            WmsMovement[]
  wmsApprovalRequests                     WmsApproval[]                   @relation("WmsRequester")
  wmsApprovalDecisions                    WmsApproval[]                   @relation("WmsApprover")
  purchaseApprovalRequests                PurchaseOrderApproval[]         @relation("PurchaseOrderApprovalRequester")
  purchaseApprovalDecisions               PurchaseOrderApproval[]         @relation("PurchaseOrderApprovalApprover")
  purchasePaymentsCreated                 PurchasePayment[]               @relation("PurchasePaymentCreator")
  purchasePaymentApprovalRequests         PurchasePaymentApproval[]       @relation("PurchasePaymentApprovalRequester")
  purchasePaymentApprovalDecisions        PurchasePaymentApproval[]       @relation("PurchasePaymentApprovalApprover")
  purchasePaymentRefundsCreated           PurchasePaymentRefund[]         @relation("PurchasePaymentRefundCreator")
  purchasePaymentRefundApprovalRequests   PurchasePaymentRefundApproval[] @relation("PurchasePaymentRefundApprovalRequester")
  purchasePaymentRefundApprovalDecisions  PurchasePaymentRefundApproval[] @relation("PurchasePaymentRefundApprovalApprover")
  financeBooksCreated                     FinanceBook[]                   @relation("FinanceBookCreator")
  financeExpensesCreated                  FinanceExpense[]                @relation("FinanceExpenseCreator")
  financeExpensesReviewed                 FinanceExpense[]                @relation("FinanceExpenseReviewer")
  financeVouchersCreated                  FinanceVoucher[]                @relation("FinanceVoucherCreator")
  financeVouchersReviewed                 FinanceVoucher[]                @relation("FinanceVoucherReviewer")
  financeVouchersPosted                   FinanceVoucher[]                @relation("FinanceVoucherPoster")
  id                                      String                          @id @default(cuid())
  email                                   String                          @unique
  name                                    String
  passwordHash                            String
  status                                  UserStatus                      @default(active)
  lastLoginAt                             DateTime?
  createdAt                               DateTime                        @default(now())
  updatedAt                               DateTime                        @updatedAt
  aiModelSettings                         AiModelSetting[]
  auditLogs                               AuditLog[]
  dataChangeVersions                      DataChangeVersion[]
  DraftRun                                DraftRun[]
  externalIntegrationSettings             ExternalIntegrationSetting[]
  listingAiChatHistories                  ListingAiChatHistory[]
  listingAiWorkspaces                     ListingAiWorkspace[]
  listingAiGallerySaves                   ListingAiGallerySave[]
  productMeetingNotes                     ProductMeetingNote[]
  wecomNotificationSettings               WeComNotificationSetting[]
  memberships                             OrganizationMember[]
  notifications                           UserNotification[]
  saihuSearchMergeHistory                 SaihuSearchMergeHistoryRecord[]
  sessions                                UserSession[]
  WorkspaceDataset                        WorkspaceDataset[]
  workspaceSnapshots                      WorkspaceSnapshot[]
  pointsAccounts                          PointsAccount[]
  pointsGrants                            PointsGrant[]
  pointsLedgers                           PointsLedger[]
  pointsPeriods                           PointsPeriod[]
  pointsOverrides                         PointsMemberOverride[]
  pointsAllocations                       PointsAllocation[]
  imageUpscaleJobs                        ImageUpscaleJob[]
  productOutboxEvents                     ProductOutboxEvent[]
  amazonDataCenterChangeRequestsRequested AmazonDataCenterChangeRequest[] @relation("AmazonDataCenterChangeRequestedBy")
  amazonDataCenterChangeRequestsApproved  AmazonDataCenterChangeRequest[] @relation("AmazonDataCenterChangeApprovedBy")
}

model WorkspaceScope {
  productCatalogEntries          ProductCatalogEntry[]
  wmsWarehouseTypes              WmsWarehouseType[]
  wmsWarehouseAddresses          WmsWarehouseAddress[]
  wmsTransferOrders              WmsTransferOrder[]
  fbaLocalPlans                  FbaLocalPlan[]
  wmsWarehouses                  WmsWarehouse[]
  wmsLots                        WmsLot[]
  wmsCommands                    WmsCommand[]
  wmsApprovals                   WmsApproval[]
  purchaseOrders                 PurchaseOrder[]
  purchaseOrderApprovals         PurchaseOrderApproval[]
  purchasePayments               PurchasePayment[]
  purchasePaymentApprovals       PurchasePaymentApproval[]
  purchasePaymentRefunds         PurchasePaymentRefund[]
  purchasePaymentRefundApprovals PurchasePaymentRefundApproval[]
  purchasePlans                  PurchasePlan[]
  purchasePlanApprovals          PurchasePlanApproval[]
  purchaseInvoices               PurchaseInvoice[]
  purchaseInvoiceApprovals       PurchaseInvoiceApproval[]
  financeBooks                   FinanceBook[]
  financeExpenses                FinanceExpense[]
  organizationId                 String
  id                             String
  name                           String
  accountId                      String                          @default("")
  marketplace                    String                          @default("")
  isDefault                      Boolean                         @default(false)
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
  organization                   Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  amazonDataExports              AmazonDataExport[]
  amazonDataCenterChanges        AmazonDataCenterChangeRequest[]
  amazonDataAccessGrants         AmazonDataAccessGrant[]
  sellfoxCredential              SellfoxIntegrationCredential?
  wmsBoms                        WmsBom[]
  wmsAssemblyOrders              WmsAssemblyOrder[]
  carriers                       Carrier[]
  thirdPartyWarehouses           ThirdPartyWarehouse[]
  unsalableAssessments           UnsalableAssessment[]
  calcSchemes                    CalcScheme[]
  reviewRecords                  ReviewRecord[]
  storePerformanceSnapshots      StorePerformanceSnapshot[]
  repricingRules                 RepricingRule[]
  competitorOfferWatches         CompetitorOfferWatch[]
  repricingQueueItems            RepricingQueueItem[]
  salesPlans                     SalesPlan[]
  purchasePaymentRequests        PurchasePaymentRequest[]
  purchaseExchangeOrders         PurchaseExchangeOrder[]
  supplierQuotations             SupplierQuotation[]
  taxInvoices                    TaxInvoice[]
  taxFilingPeriods               TaxFilingPeriod[]
  multiChannelAccounts           MultiChannelAccount[]
  multiChannelOrders             MultiChannelOrder[]
  dataDictionaries               DataDictionary[]
  dataDictionaryItems            DataDictionaryItem[]
  customFieldDefinitions         CustomFieldDefinition[]

  @@id([organizationId, id])
}

model SellfoxIntegrationCredential {
  organizationId        String
  workspaceId           String
  credentialsCiphertext String
  revision              Int            @default(1)
  updatedByUserId       String
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  workspace             WorkspaceScope @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Cascade, map: "SellfoxIntegrationCredential_workspace_fkey")

  @@id([organizationId, workspaceId])
}

model OrganizationMember {
  id                     String                          @id @default(cuid())
  organizationId         String
  userId                 String
  role                   OrganizationRole                @default(viewer)
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt
  organization           Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                   User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  amazonDataExports      AmazonDataExport[]
  amazonChangesRequested AmazonDataCenterChangeRequest[] @relation("AmazonDataCenterMemberRequestedBy")
  amazonChangesApproved  AmazonDataCenterChangeRequest[] @relation("AmazonDataCenterMemberApprovedBy")
  amazonDataAccessGrants AmazonDataAccessGrant[]
  amazonAdsSyncPlans     AmazonAdsSyncPlan[]             @relation("AmazonAdsPlanActor")
  amazonAdsSyncTasks     AmazonAdsSyncTask[]             @relation("AmazonAdsTaskActor")
  marketCallAccount      MarketCallAccount?

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
}

// Shared ERP/Lili allowance, isolated by organization and ERP user, across workspaces.
model MarketCallAccount {
  organizationId String
  userId         String
  balance        Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  member         OrganizationMember @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Restrict, map: "MarketCallAccount_member_fkey")
  entries        MarketCallEntry[]

  @@id([organizationId, userId])
}

model MarketCallEntry {
  id             String            @id
  organizationId String
  userId         String
  requestKey     String
  kind           String
  delta          Int
  status         String
  balanceAfter   Int
  provider       String?
  tool           String?
  workspaceId    String?
  runId          String?
  callId         String?
  note           String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  account        MarketCallAccount @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Restrict, map: "MarketCallEntry_account_fkey")

  @@unique([organizationId, userId, requestKey])
  @@index([organizationId, userId, createdAt, id])
}

model TeamRosterMember {
  organizationId                String
  id                            String
  name                          String
  email                         String
  department                    String
  title                         String
  roleId                        String
  status                        TeamAccountStatus @default(active)
  lastActiveAt                  String?
  sortOrder                     Int               @default(0)
  createdAt                     DateTime          @default(now())
  updatedAt                     DateTime          @updatedAt
  username                      String?
  amazonStorePermissions        String?
  multiPlatformStorePermissions String?
  phone                         String?
  lastLoginIp                   String?
  lastLoginAt                   String?
  sourceCreatedAt               String?
  password                      String?
  organization                  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, id])
  @@index([organizationId, sortOrder])
  @@index([organizationId, roleId])
  @@index([organizationId, status])
}

model OrganizationRolePermission {
  organizationId String       @id
  permissions    Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model OrganizationRosterRole {
  organizationId String
  id             String
  name           String
  description    String
  permissions    Json
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, id])
  @@index([organizationId, sortOrder])
}

model WeComNotificationSetting {
  organizationId String
  userId         String
  workspaceId    String       @default("default")
  accountId      String       @default("")
  marketplace    String       @default("")
  settings       Json
  sentRecords    Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, workspaceId, userId])
  @@index([organizationId, workspaceId, updatedAt])
  @@index([userId, updatedAt])
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  userId         String?
  idempotencyKey String?       @unique
  action         String
  entityType     String?
  entityId       String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id])
  user           User?         @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([action])
}

model FileObject {
  financeAttachments     FinanceVoucherAttachment[]
  id                     String                     @id @default(cuid())
  organizationId         String
  userId                 String
  originalName           String
  mimeType               String?
  size                   Int?
  storageKey             String
  storageType            FileStorageType            @default(local)
  status                 FileObjectStatus           @default(uploaded)
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  workspaceId            String                     @default("default")
  accountId              String                     @default("")
  marketplace            String                     @default("")
  contentHash            String?
  productBindingStatus   ProductAttachmentStatus?
  amazonCatalogImageBlob AmazonCatalogImageBlob?
  DraftRun               DraftRun[]
  amazonDataExports      AmazonDataExport[]
  exportRecords          ExportRecord[]
  jobs                   ImportJob[]
  WorkspaceDataset       WorkspaceDataset[]
  productBinding         ProductAttachmentBinding?
  productMedia           ProductMedia[]

  @@unique([organizationId, workspaceId, id], map: "FileObject_scoped_id_key")
  @@index([organizationId, createdAt])
  @@index([organizationId, workspaceId, createdAt])
  @@index([organizationId, accountId, marketplace, createdAt])
  @@index([userId, createdAt])
  @@index([organizationId, workspaceId, accountId, marketplace, storageType, contentHash], map: "FileObject_contentHash_scope_idx")
}

model ImportJob {
  executionToken    String?
  leaseExpiresAt    DateTime?
  executionAttempts Int               @default(0)
  maxAttempts       Int               @default(3)
  id                String            @id @default(cuid())
  organizationId    String
  userId            String
  fileId            String
  type              String
  status            ImportJobStatus   @default(queued)
  progress          Int               @default(0)
  error             String?
  resultKey         String?
  payload           Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  workspaceId       String            @default("default")
  accountId         String            @default("")
  marketplace       String            @default("")
  exportRecords     ExportRecord[]
  file              FileObject        @relation(fields: [fileId], references: [id], onDelete: Cascade)
  WorkspaceDataset  WorkspaceDataset?

  @@index([status, leaseExpiresAt])
  @@index([organizationId, createdAt])
  @@index([organizationId, workspaceId, createdAt])
  @@index([organizationId, accountId, marketplace, createdAt])
  @@index([userId, createdAt])
  @@index([fileId])
  @@index([status])
}

enum ImageUpscaleJobStatus {
  queued
  running
  completed
  failed
}

model ImageUpscaleJob {
  executionToken    String?
  leaseExpiresAt    DateTime?
  executionAttempts Int                   @default(0)
  maxAttempts       Int                   @default(3)
  id                String                @id @default(cuid())
  organizationId    String
  userId            String
  batchId           String
  originalName      String
  mimeType          String
  inputKey          String
  outputKey         String?
  status            ImageUpscaleJobStatus @default(queued)
  progress          Int                   @default(0)
  scale             Int
  imageKind         String
  noiseLevel        String
  model             String
  inputWidth        Int?
  inputHeight       Int?
  outputWidth       Int?
  outputHeight      Int?
  inputSize         Int
  outputSize        Int?
  processingMs      Int?
  error             String?
  createdAt         DateTime              @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  updatedAt         DateTime              @updatedAt
  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, leaseExpiresAt])
  @@index([organizationId, createdAt])
  @@index([organizationId, batchId, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model ExportRecord {
  id             String     @id @default(cuid())
  organizationId String
  userId         String
  fileId         String
  jobId          String
  resultKey      String
  fileName       String
  mimeType       String?
  size           Int?
  createdAt      DateTime   @default(now())
  workspaceId    String     @default("default")
  accountId      String     @default("")
  marketplace    String     @default("")
  draftRunId     String?
  draftIds       Json?
  validation     Json?
  lineage        Json?
  DraftRun       DraftRun?  @relation(fields: [draftRunId], references: [id])
  file           FileObject @relation(fields: [fileId], references: [id], onDelete: Cascade)
  job            ImportJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, resultKey])
  @@index([organizationId, createdAt])
  @@index([organizationId, workspaceId, createdAt])
  @@index([organizationId, accountId, marketplace, createdAt])
  @@index([userId, createdAt])
  @@index([fileId])
  @@index([draftRunId])
}

model ProductRecord {
  customsProfiles              FbaCustomsProfile[]
  wmsConsumables               WmsOutboundConsumable[]
  wmsOutboundLines             WmsOutboundLine[]
  wmsLots                      WmsLot[]
  purchaseOrderLines           PurchaseOrderLine[]
  purchasePlanLines            PurchasePlanLine[]
  purchaseInvoiceLines         PurchaseInvoiceLine[]
  id                           String                     @id
  organizationId               String
  userId                       String
  sku                          String
  payload                      Json
  createdAt                    DateTime                   @default(now())
  updatedAt                    DateTime                   @updatedAt
  workspaceId                  String                     @default("default")
  accountId                    String                     @default("")
  marketplace                  String                     @default("")
  chineseName                  String                     @default("")
  englishName                  String                     @default("")
  asin                         String                     @default("")
  status                       String                     @default("")
  source                       String                     @default("dashboard")
  supplierName                 String                     @default("")
  purchasePrice                Float                      @default(0)
  selectionOwner               String                     @default("")
  opsAssignee                  String                     @default("")
  designerAssignee             String                     @default("")
  currentOwner                 String                     @default("")
  workflowStage                String                     @default("")
  workflowDueAt                DateTime?
  isOverdue                    Boolean                    @default(false)
  operationsProgressIncomplete Boolean                    @default(false)
  revision                     Int                        @default(1)
  summary                      ProductSummaryRecord?
  texts                        ProductTextRecord[]
  projectionStates             ProductProjectionState[]
  projectionFailures           ProductProjectionFailure[]
  productMaster                ProductMaster?
  productVariants              ProductVariant[]
  productListings              ProductListing[]
  productMedia                 ProductMedia[]
  meetingNotes                 ProductMeetingNote[]
  wmsBoms                      WmsBom[]
  wmsBomLines                  WmsBomLine[]
  wmsAssemblyOrders            WmsAssemblyOrder[]
  wmsAssemblyOrderLines        WmsAssemblyOrderLine[]

  @@unique([organizationId, workspaceId, id], map: "ProductRecord_wms_scope_key")
  @@unique([organizationId, workspaceId, sku])
  @@index([organizationId, updatedAt])
  @@index([organizationId, workspaceId, updatedAt])
  @@index([organizationId, workspaceId, source, updatedAt])
  @@index([organizationId, workspaceId, source, status, updatedAt], map: "ProductRecord_organizationId_workspaceId_source_status_updated")
  @@index([organizationId, workspaceId, source, currentOwner, updatedAt], map: "ProductRecord_organizationId_workspaceId_source_owner_updated")
  @@index([organizationId, workspaceId, source, isOverdue, updatedAt], map: "ProductRecord_organizationId_workspaceId_source_overdue_updat")
  @@index([organizationId, sku])
  @@index([userId, updatedAt])
  @@index([organizationId, accountId, marketplace, updatedAt], map: "ProductRecord_organizationId_accountId_marketplace_updatedAt_id")
  @@index([organizationId, workspaceId, asin])
  @@index([organizationId, workspaceId, chineseName])
  @@index([organizationId, workspaceId, designerAssignee])
  @@index([organizationId, workspaceId, operationsProgressIncomplete], map: "ProductRecord_organizationId_workspaceId_operationsProgressInco")
  @@index([organizationId, workspaceId, opsAssignee])
  @@index([organizationId, workspaceId, purchasePrice])
  @@index([organizationId, workspaceId, selectionOwner])
  @@index([organizationId, workspaceId, status])
  @@index([organizationId, workspaceId, supplierName])
  @@index([organizationId, workspaceId, workflowDueAt])
  @@index([organizationId, workspaceId, workflowStage])
}

model Marketplace {
  id             String           @id @default(cuid())
  organizationId String
  code           String
  name           String           @default("")
  countryCode    String           @default("")
  region         String           @default("")
  currency       String           @default("")
  status         String           @default("active")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sellerAccounts SellerAccount[]
  listings       ProductListing[]

  @@unique([organizationId, code])
  @@index([organizationId, status, updatedAt])
}

model SellerAccount {
  fbaLocalPlans          FbaLocalPlan[]
  id                     String                  @id @default(cuid())
  organizationId         String
  workspaceId            String                  @default("default")
  accountKey             String
  displayName            String                  @default("")
  marketplaceCode        String                  @default("")
  marketplaceId          String?
  status                 String                  @default("active")
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  marketplace            Marketplace?            @relation(fields: [marketplaceId], references: [id], onDelete: SetNull)
  listings               ProductListing[]
  amazonSyncSources      AmazonSyncDataSource[]
  amazonDataAccessGrants AmazonDataAccessGrant[]
  amazonAdsSyncPlans     AmazonAdsSyncPlan[]     @relation("AmazonAdsPlanSeller")

  @@unique([organizationId, workspaceId, id], map: "SellerAccount_sync_scope_id_key")
  @@unique([organizationId, workspaceId, accountKey, marketplaceCode])
  @@index([organizationId, workspaceId, status, updatedAt])
  @@index([organizationId, marketplaceCode])
}

model Supplier {
  id               String            @id @default(cuid())
  organizationId   String
  name             String
  normalizedName   String
  contactName      String            @default("")
  phone            String            @default("")
  email            String            @default("")
  website          String            @default("")
  address          String            @default("")
  notes            String            @default("")
  payload          Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productLinks     ProductSupplier[]
  purchaseOrders   PurchaseOrder[]
  purchasePlans    PurchasePlan[]
  purchaseInvoices PurchaseInvoice[]

  @@unique([organizationId, normalizedName])
  @@unique([organizationId, id])
  @@index([organizationId, name])
  @@index([organizationId, updatedAt])
}

model ProductMaster {
  id              String            @id @default(cuid())
  productRecordId String            @unique
  organizationId  String
  workspaceId     String            @default("default")
  sku             String
  chineseName     String            @default("")
  englishName     String            @default("")
  brand           String            @default("")
  status          String            @default("")
  source          String            @default("dashboard")
  currentOwner    String            @default("")
  sourceRevision  Int               @default(1)
  sourceUpdatedAt DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productRecord   ProductRecord     @relation(fields: [productRecordId], references: [id], onDelete: Cascade)
  variants        ProductVariant[]
  listings        ProductListing[]
  suppliers       ProductSupplier[]
  costs           ProductCost[]
  media           ProductMedia[]

  @@unique([organizationId, workspaceId, sku])
  @@index([organizationId, workspaceId, status, updatedAt])
