  @@unique([organizationId, workspaceId, id])
  @@index([organizationId, workspaceId, status, createdAt])
  @@index([organizationId, workspaceId, asin, status])
}

/// 销售计划：目标按 SKU 拆行，实际取自订单事实，预测取历史日均 × 季节系数。
model SalesPlan {
  id                 String          @id @default(cuid())
  organizationId     String
  workspaceId        String          @default("default")
  name               String
  marketplace        String          @default("US")
  currency           String          @default("CNY")
  /// MONTH / QUARTER
  periodType         String          @default("MONTH")
  periodStart        DateTime        @db.Date
  periodEnd          DateTime        @db.Date
  /// DRAFT / ACTIVE / CLOSED
  status             String          @default("DRAFT")
