// 采购计划：需求推算 -> 人工确认 -> 审批 -> 转采购单。计划只是建议，不预占、不扣减任何库存。
model PurchasePlan {
  id               String                 @id @default(cuid())
  organizationId   String
  workspaceId      String                 @default("default")
  number           String
  supplierId       String?
  status           String                 @default("DRAFT")
  periodStart      DateTime               @db.Date
  periodEnd        DateTime               @db.Date
  /// 需求推算口径快照：销量窗口、覆盖天数、安全天数。改口径不影响已保存计划。
  salesWindowDays  Int                    @default(90)
  coverageDays     Int                    @default(60)
  safetyDays       Int                    @default(15)
  notes            String                 @default("")
  convertedOrderId String?
  createdBy        String
  revision         Int                    @default(1)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace        WorkspaceScope         @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Restrict)
  supplier         Supplier?              @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict)
  lines            PurchasePlanLine[]
  approvals        PurchasePlanApproval[]

  @@unique([organizationId, workspaceId, id])
  @@unique([organizationId, workspaceId, number])
  @@index([organizationId, workspaceId, status, periodStart])
  @@index([organizationId, workspaceId, supplierId, createdAt])
}

model PurchasePlanLine {
  id              String        @id @default(cuid())
  organizationId  String
  workspaceId     String        @default("default")
  planId          String
  productRecordId String
  /// 推算快照：现有可用、在途（含未收采购）、窗口销量。保留快照，口径可回溯。
  onHandQty       Int           @default(0)
  inboundQty      Int           @default(0)
  salesQty        Int           @default(0)
  suggestedQty    Int           @default(0)
  plannedQty      Int
  unitPrice       Decimal       @db.Decimal(20, 6)
  notes           String        @default("")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  plan            PurchasePlan  @relation(fields: [organizationId, workspaceId, planId], references: [organizationId, workspaceId, id], onDelete: Cascade)
  product         ProductRecord @relation(fields: [organizationId, workspaceId, productRecordId], references: [organizationId, workspaceId, id], onDelete: Restrict)

  @@unique([organizationId, workspaceId, id])
  @@unique([organizationId, workspaceId, planId, productRecordId])
  @@index([organizationId, workspaceId, planId])
}

model PurchasePlanApproval {
  id               String         @id @default(cuid())
  organizationId   String
  workspaceId      String         @default("default")
  planId           String
  status           String         @default("PENDING")
  expectedRevision Int
  requestHash      String
  requestedBy      String
  approvedBy       String?
  decisionReason   String         @default("")
  expiresAt        DateTime
  revision         Int            @default(1)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace        WorkspaceScope @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Restrict)
  plan             PurchasePlan   @relation(fields: [organizationId, workspaceId, planId], references: [organizationId, workspaceId, id], onDelete: Cascade)

  @@unique([organizationId, workspaceId, id])
  @@index([organizationId, workspaceId, planId, status])
}

// 采购发票：三单匹配（采购单 / 收货单 / 发票）。匹配只做核对，不改库存、不生成凭证、不覆盖应付事实。
model PurchaseInvoice {
  id                String                    @id @default(cuid())
  organizationId    String
  workspaceId       String                    @default("default")
  number            String
  /// 供应商发票号，同一供应商内唯一，用于拦截重复报销。
  supplierInvoiceNo String
  purchaseOrderId   String
  supplierId        String
  currency          String                    @default("CNY")
  status            String                    @default("DRAFT")
  /// PENDING 待匹配 / MATCHED 三单一致 / EXCEPTION 存在差异
  matchStatus       String                    @default("PENDING")
  invoiceDate       DateTime                  @db.Date
  dueDate           DateTime?                 @db.Date
  /// 容差口径快照，单位为万分之一（basis point）：50 = 0.5%
  qtyToleranceBp    Int                       @default(0)
  priceToleranceBp  Int                       @default(50)
  amountTolerance   Decimal                   @default(0) @db.Decimal(20, 6)
  subtotal          Decimal                   @db.Decimal(20, 6)
  taxAmount         Decimal                   @default(0) @db.Decimal(20, 6)
  totalAmount       Decimal                   @db.Decimal(20, 6)
  /// 最近一次匹配的差异摘要，列表直接展示，不用再算一遍
  exceptionSummary  String                    @default("")
  matchedAt         DateTime?
  /// 差异放行理由：非空才允许在 EXCEPTION 状态下提交审批
  overrideReason    String                    @default("")
  notes             String                    @default("")
  createdBy         String
  revision          Int                       @default(1)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace         WorkspaceScope            @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Restrict)
  purchaseOrder     PurchaseOrder             @relation(fields: [organizationId, workspaceId, purchaseOrderId], references: [organizationId, workspaceId, id], onDelete: Restrict)
  supplier          Supplier                  @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict)
  lines             PurchaseInvoiceLine[]
  approvals         PurchaseInvoiceApproval[]

  @@unique([organizationId, workspaceId, id])
  @@unique([organizationId, workspaceId, number])
  @@unique([organizationId, workspaceId, supplierId, supplierInvoiceNo])
  @@index([organizationId, workspaceId, status, invoiceDate])
  @@index([organizationId, workspaceId, purchaseOrderId])
}

model PurchaseInvoiceLine {
  id              String          @id @default(cuid())
  organizationId  String
  workspaceId     String          @default("default")
  invoiceId       String
  productRecordId String
  /// 匹配时点的三单数量快照：订单 / 已验收 / 本次开票
  orderedQty      Int
  receivedQty     Int             @default(0)
  invoicedQty     Int
  poUnitPrice     Decimal         @db.Decimal(20, 6)
  unitPrice       Decimal         @db.Decimal(20, 6)
  amount          Decimal         @db.Decimal(20, 6)
  taxAmount       Decimal         @default(0) @db.Decimal(20, 6)
  varianceQty     Int             @default(0)
  varianceAmount  Decimal         @default(0) @db.Decimal(20, 6)
  /// QTY_OVER_ORDER / QTY_OVER_RECEIPT / PRICE_VARIANCE / AMOUNT_MISMATCH / NO_RECEIPT / NO_ORDER_LINE
  exceptionCodes  String[]        @default([])
  notes           String          @default("")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  invoice         PurchaseInvoice @relation(fields: [organizationId, workspaceId, invoiceId], references: [organizationId, workspaceId, id], onDelete: Cascade)
  product         ProductRecord   @relation(fields: [organizationId, workspaceId, productRecordId], references: [organizationId, workspaceId, id], onDelete: Restrict)

  @@unique([organizationId, workspaceId, id])
  @@unique([organizationId, workspaceId, invoiceId, productRecordId])
  @@index([organizationId, workspaceId, invoiceId])
}

model PurchaseInvoiceApproval {
  id               String          @id @default(cuid())
  organizationId   String
  workspaceId      String          @default("default")
  invoiceId        String
  status           String          @default("PENDING")
  expectedRevision Int
  requestHash      String
  requestedBy      String
  approvedBy       String?
  decisionReason   String          @default("")
  overrideReason   String          @default("")
  expiresAt        DateTime
  revision         Int             @default(1)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace        WorkspaceScope  @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Restrict)
  invoice          PurchaseInvoice @relation(fields: [organizationId, workspaceId, invoiceId], references: [organizationId, workspaceId, id], onDelete: Cascade)

  @@unique([organizationId, workspaceId, id])
  @@index([organizationId, workspaceId, invoiceId, status])
}

