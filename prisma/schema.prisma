generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  active
  disabled
}

enum TeamAccountStatus {
  active
  pending
  disabled
}

enum OrganizationRole {
  owner
  admin
  database_admin
  operations_manager
  ppc_specialist
  listing_specialist
  logistics_specialist
  viewer
}

enum FileStorageType {
  local
  s3
  r2
}

enum FileObjectStatus {
  uploaded
  processing
  done
  failed
}

enum ImportJobStatus {
  queued
  running
  done
  failed
}

model Organization {
  id          String               @id @default(cuid())
  name        String
  slug        String               @unique
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  members     OrganizationMember[]
  teamRoster  TeamRosterMember[]
  rolePermissions OrganizationRolePermission?
  auditLogs   AuditLog[]
}

model User {
  id           String               @id @default(cuid())
  email        String               @unique
  name         String
  passwordHash String
  status       UserStatus           @default(active)
  lastLoginAt  DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  memberships  OrganizationMember[]
  sessions     UserSession[]
  auditLogs    AuditLog[]
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(viewer)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
}

model TeamRosterMember {
  organizationId String
  id             String
  name           String
  email          String
  department     String
  title          String
  roleId         String
  status         TeamAccountStatus @default(active)
  lastActiveAt   String?
  sortOrder      Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, id])
  @@index([organizationId, sortOrder])
  @@index([organizationId, roleId])
  @@index([organizationId, status])
}

model OrganizationRolePermission {
  organizationId String   @id
  permissions    Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  userId         String?
  action         String
  entityType     String?
  entityId       String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([action])
}

model FileObject {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  originalName   String
  mimeType       String?
  size           Int?
  storageKey     String
  storageType    FileStorageType  @default(local)
  status         FileObjectStatus @default(uploaded)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  jobs           ImportJob[]
  exportRecords  ExportRecord[]

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
}

model ImportJob {
  id             String          @id @default(cuid())
  organizationId String
  userId         String
  fileId         String
  type           String
  status         ImportJobStatus @default(queued)
  progress       Int             @default(0)
  error          String?
  resultKey      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  file           FileObject      @relation(fields: [fileId], references: [id], onDelete: Cascade)
  exportRecords  ExportRecord[]

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([fileId])
  @@index([status])
}

model ExportRecord {
  id             String     @id @default(cuid())
  organizationId String
  userId         String
  fileId         String
  jobId          String
  resultKey      String
  fileName       String
  mimeType       String?
  size           Int?
  createdAt      DateTime   @default(now())
  file           FileObject @relation(fields: [fileId], references: [id], onDelete: Cascade)
  job            ImportJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, resultKey])
  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([fileId])
}

model ProductRecord {
  id             String   @id
  organizationId String
  userId         String
  sku            String
  payload        Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, sku])
  @@index([organizationId, updatedAt])
  @@index([userId, updatedAt])
}

model ProductImageCopyGalleryRecord {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  sku            String
  payload        Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, sku])
  @@index([organizationId, updatedAt])
  @@index([userId, updatedAt])
}
