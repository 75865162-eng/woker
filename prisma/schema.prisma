  seasonalityBp      Int             @default(10000)
  notes              String          @default("")
  createdBy          String
  revision           Int             @default(1)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace          WorkspaceScope  @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Restrict)
  lines              SalesPlanLine[]

  @@unique([organizationId, workspaceId, id])
  @@unique([organizationId, workspaceId, name])
  @@index([organizationId, workspaceId, status, periodStart])
}

model SalesPlanLine {
  id              String         @id @default(cuid())
  organizationId  String
  workspaceId     String         @default("default")
