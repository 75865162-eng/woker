  sourceUpdatedAt         DateTime                @db.Timestamptz(3)
  rawStatus               String?
  normalizedStatus        String?
  marketplaceTimeZone     String
  capturedAt              DateTime                @db.Timestamptz(3)
  detailsUpdatedAt        DateTime?               @db.Timestamptz(3)
