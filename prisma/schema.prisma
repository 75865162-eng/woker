generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  active
  disabled
}

enum TeamAccountStatus {
  active
  pending
  disabled
}

enum OrganizationRole {
  owner
  database_admin
  operations_supervisor
  operations
  operations_assistant
  developer
  designer
  warehouse
  warehouse_supervisor
  finance
  procurement
  viewer
}

enum FileStorageType {
  local
  s3
  r2
}

enum FileObjectStatus {
  uploaded
  processing
  done
  failed
}

enum ImportJobStatus {
  queued
  running
  done
  failed
}

enum WorkerHeartbeatStatus {
  online
  stopping
  offline
}

model Organization {
  id          String               @id @default(cuid())
  name        String
  slug        String               @unique
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  members     OrganizationMember[]
  teamRoster  TeamRosterMember[]
  rolePermissions OrganizationRolePermission?
  auditLogs   AuditLog[]
  workspaceScopes WorkspaceScope[]
  dataChangeVersions DataChangeVersion[]
  workerHeartbeats WorkerHeartbeat[]
}

model User {
  id           String               @id @default(cuid())
  email        String               @unique
  name         String
  passwordHash String
  status       UserStatus           @default(active)
  lastLoginAt  DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  memberships  OrganizationMember[]
  sessions     UserSession[]
  auditLogs    AuditLog[]
  aiModelSettings AiModelSetting[]
  listingAiWorkspaces ListingAiWorkspace[]
  workspaceSnapshots WorkspaceSnapshot[]
  workspaceDatasets WorkspaceDataset[]
  draftRuns DraftRun[]
  saihuSearchMergeHistory SaihuSearchMergeHistoryRecord[]
  dataChangeVersions DataChangeVersion[]
}

model WorkspaceScope {
  organizationId String
  id             String
  name           String
  accountId      String   @default("")
  marketplace    String   @default("")
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, id])
  @@index([organizationId, accountId])
  @@index([organizationId, marketplace])
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(viewer)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
}

model TeamRosterMember {
  organizationId String
  id             String
  username       String?
  name           String
  email          String
  department     String
  title          String
  roleId         String
  status         TeamAccountStatus @default(active)
  lastActiveAt   String?
  amazonStorePermissions String?
  multiPlatformStorePermissions String?
  phone          String?
  lastLoginIp    String?
  lastLoginAt    String?
  sourceCreatedAt String?
  sortOrder      Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, id])
  @@index([organizationId, sortOrder])
  @@index([organizationId, roleId])
  @@index([organizationId, status])
}

model OrganizationRolePermission {
  organizationId String   @id
  permissions    Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  userId         String?
  action         String
  entityType     String?
  entityId       String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([action])
}

model FileObject {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  workspaceId    String           @default("default")
  accountId      String           @default("")
  marketplace    String           @default("")
  originalName   String
  mimeType       String?
  size           Int?
  storageKey     String
  storageType    FileStorageType  @default(local)
  status         FileObjectStatus @default(uploaded)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  jobs           ImportJob[]
  exportRecords  ExportRecord[]
  workspaceDatasets WorkspaceDataset[]
  draftRuns      DraftRun[]

  @@index([organizationId, createdAt])
  @@index([organizationId, workspaceId, createdAt])
  @@index([organizationId, accountId, marketplace, createdAt])
  @@index([userId, createdAt])
}

model ImportJob {
  id             String          @id @default(cuid())
  organizationId String
  userId         String
  workspaceId    String          @default("default")
  accountId      String          @default("")
  marketplace    String          @default("")
  fileId         String
  type           String
  status         ImportJobStatus @default(queued)
  progress       Int             @default(0)
  error          String?
  resultKey      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  file           FileObject      @relation(fields: [fileId], references: [id], onDelete: Cascade)
  exportRecords  ExportRecord[]
  workspaceDataset WorkspaceDataset?

  @@index([organizationId, createdAt])
  @@index([organizationId, workspaceId, createdAt])
  @@index([organizationId, accountId, marketplace, createdAt])
  @@index([userId, createdAt])
  @@index([fileId])
  @@index([status])
}

model ExportRecord {
  id             String     @id @default(cuid())
  organizationId String
  userId         String
  workspaceId    String     @default("default")
  accountId      String     @default("")
  marketplace    String     @default("")
  fileId         String
  jobId          String
  draftRunId     String?
  resultKey      String
  fileName       String
  mimeType       String?
  size           Int?
  draftIds       Json?
  validation     Json?
  lineage        Json?
  createdAt      DateTime   @default(now())
  file           FileObject @relation(fields: [fileId], references: [id], onDelete: Cascade)
  job            ImportJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  draftRun       DraftRun?  @relation(fields: [draftRunId], references: [id], onDelete: SetNull)

  @@unique([jobId, resultKey])
  @@index([organizationId, createdAt])
  @@index([organizationId, workspaceId, createdAt])
  @@index([organizationId, accountId, marketplace, createdAt])
  @@index([userId, createdAt])
  @@index([fileId])
  @@index([draftRunId])
}

model WorkspaceDataset {
  id               String     @id @default(cuid())
  organizationId   String
  userId           String
  workspaceId      String     @default("default")
  accountId        String     @default("")
  marketplace      String     @default("")
  fileId           String
  jobId            String     @unique
  sourceFileName   String
  parserVersion    String
  rowCount         Int        @default(0)
  campaignCount    Int        @default(0)
  campaignGroups   Json
  performanceRows  Json
  dataBatches      Json
  parseDiagnostics Json
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  file             FileObject @relation(fields: [fileId], references: [id], onDelete: Cascade)
  job              ImportJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  draftRuns        DraftRun[]

  @@index([organizationId, createdAt])
  @@index([organizationId, workspaceId, createdAt])
  @@index([organizationId, accountId, marketplace, createdAt])
  @@index([userId, createdAt])
  @@index([fileId])
}

model DraftRun {
  id                         String      @id @default(cuid())
  organizationId             String
  userId                     String
  workspaceId                String      @default("default")
  accountId                  String      @default("")
  marketplace                String      @default("")
  datasetId                  String?
  fileId                     String?
  scopeType                  String
  campaignGroupIds           Json
  campaignGroupNames         Json
  rulesSnapshot              Json
  overallAdDataRows          Json
  overallAdDataMatchSummary  Json
  drafts                     Json
  selectedDraftIds           Json
  summary                    Json
  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @updatedAt
  exportedAt                 DateTime?
  exportFileName             String?
  user                       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  dataset                    WorkspaceDataset? @relation(fields: [datasetId], references: [id], onDelete: SetNull)
  file                       FileObject? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  exportRecords              ExportRecord[]

  @@index([organizationId, createdAt])
  @@index([organizationId, workspaceId, createdAt])
  @@index([organizationId, accountId, marketplace, createdAt])
  @@index([userId, createdAt])
  @@index([datasetId])
  @@index([fileId])
}

model ProductRecord {
  id             String   @id
  organizationId String
  userId         String
  workspaceId    String   @default("default")
  accountId      String   @default("")
  marketplace    String   @default("")
  sku            String
  chineseName    String   @default("")
  englishName    String   @default("")
  asin           String   @default("")
  status         String   @default("")
  supplierName   String   @default("")
  purchasePrice  Float    @default(0)
  selectionOwner String   @default("")
  opsAssignee    String   @default("")
  designerAssignee String @default("")
  workflowStage  String   @default("")
  workflowDueAt  DateTime?
  operationsProgressIncomplete Boolean @default(false)
  payload        Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, workspaceId, sku])
  @@index([organizationId, updatedAt])
  @@index([organizationId, workspaceId, updatedAt])
  @@index([organizationId, accountId, marketplace, updatedAt])
  @@index([organizationId, sku])
  @@index([organizationId, workspaceId, chineseName])
  @@index([organizationId, workspaceId, asin])
  @@index([organizationId, workspaceId, status])
  @@index([organizationId, workspaceId, supplierName])
  @@index([organizationId, workspaceId, purchasePrice])
  @@index([organizationId, workspaceId, selectionOwner])
  @@index([organizationId, workspaceId, opsAssignee])
  @@index([organizationId, workspaceId, designerAssignee])
  @@index([organizationId, workspaceId, workflowStage])
  @@index([organizationId, workspaceId, workflowDueAt])
  @@index([organizationId, workspaceId, operationsProgressIncomplete])
  @@index([userId, updatedAt])
}

model ProductImageCopyGalleryRecord {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  workspaceId    String   @default("default")
  accountId      String   @default("")
  marketplace    String   @default("")
  sku            String
  payload        Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, workspaceId, sku])
  @@index([organizationId, updatedAt])
  @@index([organizationId, workspaceId, updatedAt])
  @@index([organizationId, accountId, marketplace, updatedAt])
  @@index([userId, updatedAt])
}

model DataChangeVersion {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  workspaceId    String   @default("default")
  accountId      String   @default("")
  marketplace    String   @default("")
  entityType     String
  entityId       String
  version        Int
  action         String
  summary        String?
  payload        Json
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([organizationId, entityType, entityId, version])
  @@index([organizationId, entityType, entityId, createdAt])
  @@index([organizationId, workspaceId, entityType, createdAt])
  @@index([userId, createdAt])
}

model WorkerHeartbeat {
  id             String                @id
  organizationId String?
  workerName     String
  queueName      String
  status         WorkerHeartbeatStatus @default(online)
  concurrency    Int                   @default(1)
  lastSeenAt     DateTime              @default(now())
  metadata       Json?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  organization   Organization?         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([queueName, lastSeenAt])
  @@index([organizationId, lastSeenAt])
}

model AiModelSetting {
  id              String   @id @default(cuid())
  organizationId  String
  userId          String
  workspaceId     String   @default("default")
  accountId       String   @default("")
  marketplace     String   @default("")
  activeProfileId String?
  settings        Json
  profiles        Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, workspaceId, userId])
  @@index([organizationId, updatedAt])
  @@index([organizationId, workspaceId, updatedAt])
  @@index([userId, updatedAt])
}

model ListingAiWorkspace {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  workspaceId    String   @default("default")
  accountId      String   @default("")
  marketplace    String   @default("")
  draft          Json
  records        Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, workspaceId, userId])
  @@index([organizationId, updatedAt])
  @@index([organizationId, workspaceId, updatedAt])
  @@index([userId, updatedAt])
}

model WorkspaceSnapshot {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  workspaceId    String   @default("default")
  accountId      String   @default("")
  marketplace    String   @default("")
  version        Int      @default(1)
  savedAt        DateTime @default(now())
  snapshot       Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, workspaceId, userId])
  @@index([organizationId, updatedAt])
  @@index([organizationId, workspaceId, updatedAt])
  @@index([userId, updatedAt])
}

model SaihuSearchMergeHistoryRecord {
  id             String   @id
  organizationId String
  userId         String
  workspaceId    String   @default("default")
  accountId      String   @default("")
  marketplace    String   @default("")
  action         String
  sourceFileName String
  outputFileName String?
  summary        Json
  rows           Json
  createdAt      DateTime
  savedAt        DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, workspaceId, createdAt])
  @@index([organizationId, accountId, marketplace, createdAt])
  @@index([userId, createdAt])
}

model SellfoxStore {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String   @default("default")
  externalId     String
  name           String   @default("")
  marketplace    String   @default("")
  country        String   @default("")
  status         String   @default("")
  payload        Json
  lastSyncedAt   DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  hourlyMetrics  SellfoxHourlyMetric[]
  productDailySnapshots SellfoxProductDailySnapshot[]

  @@unique([organizationId, workspaceId, externalId])
  @@index([organizationId, workspaceId, updatedAt])
}

model SellfoxProductDailySnapshot {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String   @default("default")
  storeId        String
  reportDate     String
  sourceKey      String
  sku            String   @default("")
  msku           String   @default("")
  asin           String   @default("")
  parentAsin     String   @default("")
  title          String   @default("")
  currency       String   @default("")
  saleQuantity   Int      @default(0)
  fbaQuantity    Int      @default(0)
  fbmQuantity    Int      @default(0)
  saleRevenue    Float    @default(0)
  grossProfit    Float    @default(0)
  grossProfitRate Float   @default(0)
  adCost         Float    @default(0)
  refundRate     Float    @default(0)
  payload        Json
  syncedAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  store          SellfoxStore @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, reportDate, sourceKey])
  @@index([organizationId, workspaceId, reportDate])
  @@index([storeId, reportDate, saleRevenue])
  @@index([organizationId, workspaceId, msku])
  @@index([organizationId, workspaceId, asin])
}

model SellfoxHourlyMetric {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String   @default("default")
  storeId        String
  reportDate     String
  hour           Int
  adType         String
  entityType     String
  entityId       String
  entityName     String   @default("")
  impressions    Int      @default(0)
  clicks         Int      @default(0)
  cost           Float    @default(0)
  sales          Float    @default(0)
  orders         Int      @default(0)
  payload        Json
  syncedAt       DateTime @default(now())
  store          SellfoxStore @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, reportDate, hour, adType, entityType, entityId])
  @@index([organizationId, workspaceId, reportDate])
}

model SellfoxSyncRun {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  workspaceId    String   @default("default")
  resource       String
  status         String   @default("running")
  summary        Json?
  error          String?
  startedAt      DateTime @default(now())
  finishedAt     DateTime?

  @@index([organizationId, workspaceId, startedAt])
}

model SellfoxProductBackfillState {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String   @default("default")
  nextReportDate String
  emptyDayStreak Int      @default(0)
  status         String   @default("running")
  lastError      String?
  lastRunAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, workspaceId])
  @@index([status, updatedAt])
}
