  counter                User?                @relation(fields: [countedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, workspaceId, stocktakeId, locationId, lotId], map: "WmsStocktakeLine_scope_lot_key")
}

