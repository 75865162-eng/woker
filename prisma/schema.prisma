  /// DRAFT / FILED / PAID / VOID
  status         String         @default("DRAFT")
  filingPeriod   String         @default("")
  createdBy      String
  revision       Int            @default(1)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
