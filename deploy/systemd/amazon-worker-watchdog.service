[Unit]
Description=Worker watchdog - auto-restart offline ERP workers
After=network-online.target docker.service amazon-web.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
WorkingDirectory=/opt/amazon-ad-bulk-current
EnvironmentFile=/opt/amazon-ad-bulk-operation/.env
Environment=NODE_ENV=production
Environment=ERP_RUNTIME_MODE=production
Environment=NEXT_TELEMETRY_DISABLED=1
# root is required to systemctl restart other services; the watchdog only reads
# heartbeats and restarts registered worker units, never touches business data.
ExecStart=/usr/bin/node scripts/runtime/worker-watchdog.mjs
TimeoutStartSec=90
User=root
Group=root
NoNewPrivileges=true
CapabilityBoundingSet=
UMask=0077
UnsetEnvironment=MIGRATION_DATABASE_URL POSTGRES_PASSWORD

[Install]
WantedBy=multi-user.target
