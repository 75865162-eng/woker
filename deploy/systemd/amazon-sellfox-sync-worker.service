[Unit]
Description=Sellfox read-only sync worker
After=network-online.target docker.service amazon-web.service
Wants=network-online.target

StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/opt/amazon-ad-bulk-current
EnvironmentFile=/opt/amazon-ad-bulk-operation/.env
Environment=NODE_ENV=production
Environment=ERP_RUNTIME_MODE=production
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/usr/bin/npm run worker:sellfox-sync
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30
User=amazon-erp
Group=amazon-erp
NoNewPrivileges=true
CapabilityBoundingSet=
UMask=0077
Environment=HOME=/var/lib/amazon-erp
UnsetEnvironment=MIGRATION_DATABASE_URL POSTGRES_PASSWORD

[Install]
WantedBy=multi-user.target
