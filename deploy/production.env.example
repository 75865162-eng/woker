# =============================================================================
# PRODUCTION EnvironmentFile for systemd (systemd parses KEY=VALUE, no quotes).
# =============================================================================
# 1. Copy to a path OUTSIDE the release tree, e.g. /opt/amazon-ad-bulk-operation/.env
#      install -m 600 deploy/production.env.example /opt/amazon-ad-bulk-operation/.env
# 2. Generate all secrets in one step:
#      npm run prod:env:init -- --output /opt/amazon-ad-bulk-operation/.env
#    It replaces every GENERATE: token with a cryptographically random value.
# 3. Fill every REPLACE: token with real operator / Amazon values.
# 4. Validate before going live:
#      npm run check:production -- --env /opt/amazon-ad-bulk-operation/.env --gate full
#
# NEVER commit the rendered file. NEVER reuse the local development .env here:
# local keys are bound to the loopback Docker database and a weak bootstrap
# account. Production must use a fresh database and freshly generated keys.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=production
ERP_RUNTIME_MODE=production
NEXT_TELEMETRY_DISABLED=1
PORT=3000
HOSTNAME=127.0.0.1
# Emit Strict-Transport-Security. Enable ONLY after every public hostname is
# correctly terminated with valid TLS; a wrong value can lock browsers out.
ERP_HSTS_ENABLED=true

# --- 数据库与队列：现有 CI 部署使用本机 Docker，不更换运行环境来源 ------
# DATABASE_URL 必须为经 DBA 验收的无所有权、无 DDL 的应用角色，不是 POSTGRES_USER。
DATABASE_URL=REPLACE:postgresql://APP_RUNTIME_USER:PASSWORD@127.0.0.1:5432/DBNAME
# 仅 CI artifact 的受控迁移子进程使用；systemd 明确移除该变量。
MIGRATION_DATABASE_URL=REPLACE:postgresql://MIGRATION_OWNER:PASSWORD@127.0.0.1:5432/DBNAME
REDIS_URL=REPLACE:redis://127.0.0.1:6379
QUEUE_DRIVER=redis
PRISMA_TRANSACTION_MAX_WAIT_MS=10000
PRISMA_TRANSACTION_TIMEOUT_MS=30000
POSTGRES_DB=REPLACE:DBNAME
POSTGRES_USER=REPLACE:USER
POSTGRES_PASSWORD=GENERATE:24:hex

# --- Auth --------------------------------------------------------------------
AUTH_DRIVER=database
AUTH_SECRET=GENERATE:48:base64url
BOOTSTRAP_ORG_NAME=REPLACE:Your Company
BOOTSTRAP_ORG_SLUG=REPLACE:your-company
BOOTSTRAP_ADMIN_EMAIL=REPLACE:ops@your-domain.com
BOOTSTRAP_ADMIN_PASSWORD=GENERATE:24:base64url
# Public HTTPS origin of the deployment, no trailing slash.
AUTH_PUBLIC_ORIGIN=REPLACE:https://erp.your-domain.com
AUTH_TRUSTED_PROXY=caddy
LILI_PUBLIC_ORIGIN=REPLACE:https://erp.your-domain.com
# Session lifetime (seconds). OWNER/database_admin default to 5 days with a
# 5-day floor; all other roles default to 12 hours. Both optional overrides
# are honored by src/lib/auth/session.ts (privileged value is clamped to >=5d).
AUTH_SESSION_MAX_AGE_SECONDS=43200
AUTH_PRIVILEGED_SESSION_MAX_AGE_SECONDS=432000

# --- Credential encryption keys (32 raw bytes, Base64) ----------------------
# Generate ONCE. Rotating these makes stored Amazon / Sellfox credentials
# undecryptable. Back them up separately from the database dump.
AMAZON_SP_API_ENCRYPTION_KEY=GENERATE:32:base64
AMAZON_ADS_ENCRYPTION_KEY=GENERATE:32:base64
SELLFOX_CREDENTIAL_ENCRYPTION_KEY=GENERATE:32:base64

# --- Amazon SP-API (server-side only, never NEXT_PUBLIC_) -------------------
# These are the real LWA application values from Seller Central.
AMAZON_SP_API_LWA_CLIENT_ID=REPLACE:amzn1.application-oa2-client.xxxxxxxx
AMAZON_SP_API_LWA_CLIENT_SECRET=REPLACE:amzn1.oa2-cs.v1.xxxxxxxx
# LWA Client Secret 签发日期（YYYY-MM-DD），用于 180 天轮换提醒；由凭证生命周期审计读取。
AMAZON_LWA_CLIENT_SECRET_ISSUED_AT=REPLACE:YYYY-MM-DD
# Required by the OAuth consent flow (src/lib/amazon-sync/oauth.ts). The path
# must be EXACTLY /api/integrations/amazon/sp-api/oauth/callback (code validates it).
AMAZON_SP_API_APPLICATION_ID=REPLACE:amzn1.application.xxxxxxxx
AMAZON_SP_API_OAUTH_REDIRECT_URI=REPLACE:https://erp.your-domain.com/api/integrations/amazon/sp-api/oauth/callback
AMAZON_SP_API_REFRESH_TOKEN=REPLACE:Atzr|xxxxxxxx
AMAZON_SP_API_ENDPOINT=https://sellingpartnerapi-na.amazon.com
AMAZON_SP_API_AWS_REGION=us-east-1
# Optional legacy AWS SigV4 signing. Current LWA-only flow does not need them.
AMAZON_SP_API_AWS_ACCESS_KEY_ID=
AMAZON_SP_API_AWS_SECRET_ACCESS_KEY=
AMAZON_SP_API_AWS_SESSION_TOKEN=
# Bind process-level credentials to ONE ERP tenant scope before enabling the
# live connection validation request. Fill with the organization/workspace ids
# created by the bootstrap admin.
AMAZON_SP_API_ALLOWED_ORGANIZATION_ID=REPLACE:org-id
AMAZON_SP_API_ALLOWED_WORKSPACE_ID=REPLACE:workspace-id
AMAZON_SP_API_SELLER_BINDINGS=

# --- Amazon Ads API ----------------------------------------------------------
AMAZON_ADS_LWA_CLIENT_ID=REPLACE:amzn1.application-oa2-client.xxxxxxxx
AMAZON_ADS_LWA_CLIENT_SECRET=REPLACE:amzn1.oa2-cs.v1.xxxxxxxx
# Ads LWA Client Secret 签发日期（YYYY-MM-DD），用于 180 天轮换提醒。
AMAZON_ADS_LWA_CLIENT_SECRET_ISSUED_AT=REPLACE:YYYY-MM-DD
AMAZON_ADS_OAUTH_REDIRECT_URI=REPLACE:https://erp.your-domain.com/api/amazon-ads/oauth/callback
# AMAZON_ADS_SYNC_ENABLED=false
# AMAZON_ADS_REPORTING_MODE=live

# --- Execution boundaries ----------------------------------------------------
# "cloud" is REQUIRED for official SP-API / Ads OAuth, reads and report
# downloads. "local" deliberately confines the process to local replicas.
AMAZON_API_EXECUTION_ROLE=cloud
# Keep both write gates false. Enabling either requires a separately approved
# cloud rollout, a scoped policy and independent approval.
AMAZON_FBA_REMOTE_EXECUTION_ENABLED=false
AMAZON_ADS_EXECUTION_ENABLED=false
AMAZON_CLOUD_EXECUTOR_URL=
AMAZON_CLOUD_BRIDGE_SECRET=

# --- Workers -----------------------------------------------------------------
WORKER_CONCURRENCY=2
PRODUCT_OUTBOX_WORKER_CONCURRENCY=2
AMAZON_SYNC_WORKER_MODE=standard
AMAZON_SYNC_WORKER_CONCURRENCY=1
IMAGE_UPSCALE_WORKER_CONCURRENCY=1
AMAZON_INVENTORY_FRESHNESS_MINUTES=360
# REQUIRED for /operations/sync-center: exact [organizationId, workspaceId] pairs.
# Read the ids from the bootstrap admin's organization after first login.
AMAZON_SYNC_CENTER_SCOPES=REPLACE:[["org-id","workspace-id"]]
# AMAZON_ADS_SYNC_SCOPES=[]

# --- File / image storage ----------------------------------------------------
# "local" is only acceptable with a persistent mounted volume on BOTH web and
# worker hosts. Prefer s3/r2 for multi-host deployments.
STORAGE_DRIVER=local
UPLOAD_DIR=/var/lib/amazon-erp/uploads
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
REALESRGAN_NCNN_BIN=tools/realesrgan-ncnn-vulkan/realesrgan-ncnn-vulkan
REALESRGAN_TILE_SIZE=256
REALESRGAN_GPU_ID=

# --- Sellfox / MCP / AI (optional, leave empty to disable) -------------------
SELLFOX_CLIENT_ID=
SELLFOX_CLIENT_SECRET=
SELLFOX_REQUEST_TIMEOUT_MS=30000
TOGOAPI_API_KEY=
TOGOAPI_BASE_URL=https://api.togoapi.com
TOGOAPI_MODEL=gpt-5.5
TOGOAPI_WIRE_API=responses
TOGOAPI_ACTOR_AUTHORIZATION=local-image-extension
TOGOAPI_IMAGE_API_KEY=
TOGOAPI_IMAGE_BASE_URL=https://api.togoapi.com/v1
TOGOAPI_IMAGE_MODEL=gpt-image-2
TOGOAPI_IMAGE_WIRE_API=image_generations
AIGOCODE_API_KEY=
AIGOCODE_BASE_URL=https://api.aigocode.app/v1
AIGOCODE_MODEL=gpt-5.5
MCP_PG_READONLY_URL=
AMAZON_MCP_PG_READONLY_URL=
# Sellfox read-through result cache (P0). Requires REDIS_URL; fail-open on errors.
SELLFOX_CACHE_ENABLED=false
# SELLFOX_CACHE_TTL_SALES=300
# SELLFOX_CACHE_TTL_OVERVIEW=60
MCP_ORG_ID=
MCP_WORKSPACE_ID=default
MCP_STORE_IDS=
MCP_DISABLE_SHARED_TOKEN=true
OPS_CLI_ORGANIZATION_ID=
OPS_CLI_ACTOR_USER_ID=
OPS_CLI_WORKSPACE_IDS=
