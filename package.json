{
  "name": "ppc-saas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/next-run.mjs .next-dev dev --turbopack",
    "build": "node scripts/next-run.mjs .next-build build",
    "start": "node scripts/next-run.mjs .next-build start",
    "start:standalone": "node .next-build/standalone/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed-admin": "node --env-file=.env scripts/seed-admin.mjs",
    "db:sync-roster-users": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/sync-roster-login-users.ts",
    "products:refresh-derived": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/refresh-product-derived-fields.ts",
    "products:repair-projections": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/repair-product-projections.ts",
    "products:scan-statuses": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/scan-product-statuses.ts",
    "products:benchmark": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/benchmark-product-domain.ts",
    "products:backfill-image-assets": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/backfill-product-image-assets.ts",
    "worker": "tsx scripts/import-worker.ts",
    "worker:image-upscale": "tsx scripts/image-upscale-worker.ts",
    "worker:amazon-sync": "tsx scripts/amazon-sync-worker.ts",
    "worker:sellfox-sync": "tsx scripts/sellfox-sync-worker.ts",
    "sellfox:backfill-sales": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/sellfox-sales-backfill.ts",
    "sellfox:ads-reparse-cache": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/sellfox-ads-reparse-from-cache.ts",
    "ops:cli": "tsx scripts/ops-cli.ts",
    "setup:realesrgan": "powershell -ExecutionPolicy Bypass -File scripts/setup-realesrgan-ncnn.ps1",
    "setup:realesrgan:linux": "bash scripts/setup-realesrgan-ncnn-linux.sh",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:products:browser": "playwright test --config tests/browser/playwright.config.ts",
    "test:sellfox:browser": "playwright test --config tests/browser/sellfox.config.ts",
    "test:operations:browser": "playwright test --config tests/browser/operations.config.ts",
    "check:fast": "npm run test && npm run lint && npm run typecheck",
    "check": "npm run test && npm run lint && npm run build",
    "selection:run": "tsx scripts/selection-pipeline/src/cli.ts run",
    "selection:collect": "tsx scripts/selection-pipeline/src/cli.ts collect",
    "selection:tag": "tsx scripts/selection-pipeline/src/cli.ts tag",
    "selection:suppliers": "tsx scripts/selection-pipeline/src/cli.ts suppliers",
    "selection:workbook": "tsx scripts/selection-pipeline/src/cli.ts workbook",
    "selection:create": "tsx scripts/selection-pipeline/src/cli.ts create",
    "erp": "tsx scripts/erp-cli/src/cli.ts",
    "test:selection": "tsx --test scripts/selection-pipeline/selection.test.ts",
    "test:selection:create": "node scripts/selection-pipeline/run-create-integration.mjs",
    "test:erp": "node scripts/erp-cli/run-integration.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1129.0",
    "@aws-sdk/s3-request-presigner": "^3.1155.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bullmq": "^5.80.9",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.44.0",
    "next": "^15.5.25",
    "pako": "^3.0.1",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "undici": "^8.10.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "fast-uri": "^3.1.7",
    "js-yaml": "^4.3.2",
    "deepmerge-ts": "^8.0.0",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.28",
    "mysql2": "^3.24.4",
    "uuid": "^11.1.1"
  }
}
