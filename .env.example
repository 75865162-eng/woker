AIGOCODE_API_KEY=your_api_key_here
AIGOCODE_BASE_URL=https://api.aigocode.app/v1
AIGOCODE_MODEL=gpt-5.4

# Database and queue
AUTH_DRIVER=database
DATABASE_URL=postgresql://amazon_bulk_ad:amazon_bulk_ad@127.0.0.1:5432/amazon_bulk_ad
REDIS_URL=redis://127.0.0.1:6379
QUEUE_DRIVER=inline

# Auth bootstrap. Local restore account is 1 / 1. Change these before real company use.
AUTH_SECRET=change-this-local-secret-before-production
BOOTSTRAP_ORG_NAME=Amazon Operations
BOOTSTRAP_ORG_SLUG=amazon-ops
BOOTSTRAP_ADMIN_EMAIL=1
BOOTSTRAP_ADMIN_PASSWORD=1

# File and image asset storage
STORAGE_DRIVER=local
UPLOAD_DIR=uploads

# QQ Bot webhook. Configure callback URL as https://your-domain.com/api/bots/qq/webhook
QQ_BOT_APP_ID=
QQ_BOT_SECRET=
QQ_BOT_API_BASE_URL=https://api.bot.qq.com
QQ_BOT_SANDBOX=true
QQ_BOT_SIGNATURE_CHECK=true
QQ_BOT_CODEX_ENABLED=true
QQ_BOT_CODEX_BIN=codex
QQ_BOT_CODEX_WORKDIR=
QQ_BOT_CODEX_SANDBOX=workspace-write
QQ_BOT_CODEX_MODEL=
QQ_BOT_ALLOWED_USER_IDS=
QQ_BOT_WS_INTENTS=33554432
QQ_BOT_WS_RECONNECT_MS=5000

# Use STORAGE_DRIVER=s3 or STORAGE_DRIVER=r2 with these values when moving assets to S3/R2
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
