# Default AI provider for Listing AI and related optimize flows.
TOGOAPI_API_KEY=your_api_key_here
TOGOAPI_BASE_URL=https://api.togoapi.com
TOGOAPI_MODEL=gpt-5.5
TOGOAPI_WIRE_API=responses
# Matches the Codex-compatible TogoAPI request header. Override when required by the provider.
TOGOAPI_ACTOR_AUTHORIZATION=local-image-extension
TOGOAPI_IMAGE_API_KEY=your_image_api_key_here
TOGOAPI_IMAGE_BASE_URL=https://api.togoapi.com/v1
TOGOAPI_IMAGE_MODEL=gpt-image-2
TOGOAPI_IMAGE_WIRE_API=image_generations

AIGOCODE_API_KEY=your_api_key_here
AIGOCODE_BASE_URL=https://api.aigocode.app/v1
AIGOCODE_MODEL=gpt-5.5

# Database and queue
AUTH_DRIVER=database
DATABASE_URL=postgresql://amazon_bulk_ad:amazon_bulk_ad@127.0.0.1:5432/amazon_bulk_ad
POSTGRES_DB=amazon_bulk_ad
POSTGRES_USER=amazon_bulk_ad
POSTGRES_PASSWORD=replace-with-a-random-hex-password
PRISMA_TRANSACTION_MAX_WAIT_MS=10000
PRISMA_TRANSACTION_TIMEOUT_MS=30000
REDIS_URL=redis://127.0.0.1:6379
QUEUE_DRIVER=redis
WORKER_CONCURRENCY=2
PRODUCT_OUTBOX_WORKER_CONCURRENCY=2
IMAGE_UPSCALE_WORKER_CONCURRENCY=1

# Amazon SP-API. Keep these server-side only; never use NEXT_PUBLIC_ names.
# Required to encrypt credentials entered in Settings (generate 32 random bytes, then Base64-encode them).
AMAZON_SP_API_ENCRYPTION_KEY=
AMAZON_SP_API_LWA_CLIENT_ID=
AMAZON_SP_API_LWA_CLIENT_SECRET=
AMAZON_SP_API_REFRESH_TOKEN=
AMAZON_SP_API_AWS_ACCESS_KEY_ID=
AMAZON_SP_API_AWS_SECRET_ACCESS_KEY=
# Optional for temporary AWS credentials. Never expose this value to the browser.
AMAZON_SP_API_AWS_SESSION_TOKEN=
# Defaults to the North America production endpoint. Use the appropriate regional production endpoint for the seller account.
AMAZON_SP_API_ENDPOINT=https://sellingpartnerapi-na.amazon.com
AMAZON_SP_API_AWS_REGION=us-east-1
# Bind process-level credentials to one ERP tenant scope. Required before the real connection validation request is enabled.
AMAZON_SP_API_ALLOWED_ORGANIZATION_ID=
AMAZON_SP_API_ALLOWED_WORKSPACE_ID=
# Legacy server-only fallback when the workspace has no database seller bindings. accountKey is not inferred.
# JSON array fields: organizationId, workspaceId, sellerAccountId, marketplaceId, amazonSellerId, authorizedResources.
AMAZON_SP_API_SELLER_BINDINGS=
# Dedicated inventory synchronizer. Keep concurrency low to respect SP-API rate limits.
AMAZON_SYNC_WORKER_CONCURRENCY=1
# Inventory is marked stale after this many minutes without a successful snapshot (15-1440, default 360).
AMAZON_INVENTORY_FRESHNESS_MINUTES=360

# Auth bootstrap. Local restore account is 1 / 1. Change these before real company use.
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BOOTSTRAP_ORG_NAME=Amazon Operations
BOOTSTRAP_ORG_SLUG=amazon-ops
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password

# File and image asset storage
STORAGE_DRIVER=local
UPLOAD_DIR=uploads

# Use STORAGE_DRIVER=s3 or STORAGE_DRIVER=r2 with these values when moving assets to S3/R2
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Real-ESRGAN worker engine. Linux production uses the binary installed by
# npm run setup:realesrgan:linux on the server.
REALESRGAN_NCNN_BIN=tools/realesrgan-ncnn-vulkan/realesrgan-ncnn-vulkan
REALESRGAN_TILE_SIZE=256
REALESRGAN_GPU_ID=

# Internal local-process CLI. Bind an existing active organization member and explicit workspaces.
# No HTTP listener or Amazon credentials are accepted by the CLI.
OPS_CLI_ORGANIZATION_ID=
OPS_CLI_ACTOR_USER_ID=
OPS_CLI_WORKSPACE_IDS=
# Default false. Even true fails NOT_IMPLEMENTED in this release; never enables live Ads writes.
AMAZON_ADS_EXECUTION_ENABLED=false

# Sellfox Open API. Server-only; never expose with NEXT_PUBLIC_ prefixes.
SELLFOX_CLIENT_ID=
SELLFOX_CLIENT_SECRET=
SELLFOX_REQUEST_TIMEOUT_MS=30000
