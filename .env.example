AIGOCODE_API_KEY=your_api_key_here
AIGOCODE_BASE_URL=https://api.aigocode.com
AIGOCODE_MODEL=gpt-5.4

# File and image asset storage
STORAGE_DRIVER=local
UPLOAD_DIR=uploads

# Use STORAGE_DRIVER=s3 or STORAGE_DRIVER=r2 with these values when moving assets to S3/R2
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
